amends "./pkl/Spec.pkl"

// pkspec 導入試験（ADR-0001 M1）：spec/constraints.ts から5件を移した。
// 全面移行するかは、この試験の摩擦で決める（判定の観点は README.md）

feature = "ai-research constraints (trial)"

goals {
  new Goal {
    id = "GOAL-FAST"
    name = "調査にかかる時間を短くする"
    priority = 90
    reviewStatus = "approved"
  }
  new Goal {
    id = "GOAL-VERIFIED"
    name = "答えの根拠は、原文と照合された引用である"
    priority = 85
    reviewStatus = "approved"
  }
  new Goal {
    id = "GOAL-OBSERVABLE"
    name = "調査の記録を、トークンをほぼ使わずに本人が見られる"
    priority = 50
    reviewStatus = "approved"
  }
}

scenarios {
  new {
    id = "W-01"
    name = "依頼から60秒以内に、向きを確かめられる最初の結果を出す"
    tags { "spec" }
    severity = "critical"
    reviewStatus = "approved"
    contributes { "GOAL-FAST" }
  }
  new {
    id = "INV-8"
    name = "締め切りで終わっていない現在の版の作業は、done でなければ pending に、done なら cutoffs に必ず現れる"
    tags { "spec" }
    severity = "critical"
    reviewStatus = "approved"
    contributes { "GOAL-VERIFIED"; "GOAL-FAST" }
  }
  new {
    id = "Q-01"
    name = "主張ごとに出典と照合の状態が分かる。状態は「引用が原文にあるか」だけを表す。ラベルの一覧は1か所で決める"
    tags { "spec" }
    severity = "critical"
    reviewStatus = "approved"
    contributes { "GOAL-VERIFIED" }
  }
  new {
    id = "C-01"
    name = "モデルに見せる追加は research_view 1つだけ。ほかは app 専用"
    tags { "spec" }
    severity = "critical"
    reviewStatus = "approved"
    contributes { "GOAL-OBSERVABLE" }
  }
  new {
    id = "S-05"
    name = "会話で回るターン数と流し込む量が、会話の長さや作業場所によって増えない"
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    contributes { "GOAL-FAST" }
    openQuestions { "目標値 10秒の妥当性は未計測（bench で測る）" }
  }
}
