amends "./pkl/Spec.pkl"

// 壊した変種（空振りの防止）：実装のない approved spec を1件足す。
// pkspec check がこれで exit 1 になることを確かめる（green しか出ない検査は信用しない）

feature = "ai-research constraints (broken variant)"

goals {
  new Goal { id = "GOAL-FAST"; name = "調査にかかる時間を短くする"; priority = 90; reviewStatus = "approved" }
}

scenarios {
  new {
    id = "W-01"
    name = "依頼から60秒以内に、向きを確かめられる最初の結果を出す"
    tags { "spec" }
    severity = "critical"
    reviewStatus = "approved"
    contributes { "GOAL-FAST" }
  }
  new {
    id = "ZZZ-999"
    name = "実装のない制約（検査が落ちることの確認用）"
    tags { "spec" }
    severity = "critical"
    reviewStatus = "approved"
    contributes { "GOAL-FAST" }
  }
}
