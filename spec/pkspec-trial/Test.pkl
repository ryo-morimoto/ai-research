amends "./pkl/Test.pkl"

// 実装の宣言（specRef）。中身は「その制約の vitest／仕様／bench が本当に存在するか」を
// grep で確かめる薄い検査（scripts/check-constraints.mjs の grep 検査と同じ意味）。
// vitest のテストそのものへの接続は Adapter.pkl の overlays にある

tests {
  new {
    name = "W-01 は run.test の締め切りの試験が実装"
    specRef { "W-01" }
    body = new CmdTest { cmd = "grep -q 'W-01' ../../packages/hub/test/run.test.ts" }
  }
  new {
    name = "INV-8 は specs/run.qnt と run.test が実装"
    specRef { "INV-8" }
    body = new CmdTest { cmd = "grep -q 'INV-8' ../../specs/run.qnt && grep -q 'INV-8' ../../packages/hub/test/run.test.ts" }
  }
  new {
    name = "Q-01 は照合の性質テストと check-budget のラベル検査が実装"
    specRef { "Q-01" }
    body = new CmdTest { cmd = "grep -q 'Q-01' ../../packages/core/test/properties.test.ts && grep -q 'Q-01' ../../scripts/check-budget.mjs" }
  }
  new {
    name = "C-01 は mcp.test の tools/list の固定が実装"
    specRef { "C-01" }
    body = new CmdTest { cmd = "grep -q 'C-01' ../../packages/hub/test/mcp.test.ts" }
  }
  new {
    name = "S-05 は bench の依頼セットで測る"
    specRef { "S-05" }
    body = new CmdTest { cmd = "test -f ../../bench/run_cases.py" }
  }
}
