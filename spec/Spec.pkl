    severity = "critical"
    reviewStatus = "approved"
    contributes { "GOAL-FAST"; "GOAL-NO-BURDEN" }
  }
  new {
    id = "P-04"
    name = "利用者への問いは結果と一緒に出し、返事を待って作業を止めない"
    tags { "spec"; "strength:MUST"; "area:policy"; "ops" }
    severity = "critical"
    reviewStatus = "approved"
    contributes { "GOAL-FAST" }
  }
  new {
    id = "P-05"
    name = "システムの失敗は、種別・再試行の可否・次の手と一緒に値で返す"
    tags { "spec"; "strength:MUST"; "area:boundary" }
    severity = "critical"
    reviewStatus = "approved"
    contributes { "GOAL-FAST" }
  }
  new {
    id = "P-06"
    name = "作業が尽きたら待たせず終わる。0件のときは理由（見つからない/取れない/検索していない）が分かる"
    tags { "spec"; "strength:MUST"; "area:run" }
    severity = "critical"
    reviewStatus = "approved"
    contributes { "GOAL-FAST" }
  }
  new {
    id = "P-07"
    name = "取得できた出典は、段落が選ばれなくても行き止まりにしない（find か経路外で読める）"
    tags { "spec"; "strength:MUST"; "area:run/route" }
    severity = "critical"
    reviewStatus = "approved"
    contributes { "GOAL-FAST" }
  }
  new {
    id = "Q-01"
    name = "主張ごとに出典と照合の状態が分かる。状態は「引用が原文にあるか」だけを表す。ラベルの一覧は1か所で決める"
    tags { "spec"; "strength:MUST"; "area:verify/policy" }
    severity = "critical"
    reviewStatus = "approved"
    contributes { "GOAL-VERIFIED" }
  }
  new {
    id = "Q-02"
    name = "台帳から持ち込んだ事実を使った結果は、その場で取り直した場合と同じになる"
    tags { "spec"; "strength:MUST"; "area:ledger" }
    severity = "critical"
    reviewStatus = "approved"
    contributes { "GOAL-VERIFIED" }
  }
  new {
    id = "Q-03"
    name = "システムが作った文（要約・解釈・結論）を、次の調査の根拠として持ち込まない"
    tags { "spec"; "strength:MUST-NOT"; "area:ledger/core" }
    severity = "critical"
    reviewStatus = "approved"
    contributes { "GOAL-VERIFIED" }
  }
  new {
    id = "Q-04"
    name = "答えに影響した喪失は1件ずつ、それ以外は件数と URL で分かる。進行中は喪失と区別する"
    tags { "spec"; "strength:MUST"; "area:run" }
    severity = "critical"
    reviewStatus = "approved"
    contributes { "GOAL-VERIFIED" }
  }
  new {
    id = "Q-05"
    name = "事実・手順・道具の版・取得条件が機械ごとに分かれていない"
