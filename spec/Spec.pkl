    reviewStatus = "approved"
    contributes { "GOAL-VERIFIED"; "GOAL-SAME-EVERYWHERE" }
  }
  new {
    id = "Q-07"
    name = "経路を通らずに得た内容は、結果の上でそれと分かり、理由が示される。確認済の印は付かず台帳にも入らない"
