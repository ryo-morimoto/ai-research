  }
  new {
    id = "S-06"
    name = "会話に流し込むのは、問いに関係する段落と最小の説明だけ。言語が違っても関係段落に届き、届かなければ理由が分かる"
    tags { "spec"; "strength:MUST"; "area:select/policy" }
    severity = "critical"
    reviewStatus = "approved"
    contributes { "GOAL-FAST" }
  }
  new {
    id = "P-01"
    name = "並行する作業のうち遅いものが、他の結果の提示を止めない"
    tags { "spec"; "strength:MUST"; "area:run" }
    severity = "critical"
    reviewStatus = "approved"
    contributes { "GOAL-FAST" }
  }
  new {
    id = "P-02"
    name = "取れない出典は時間上限で打ち切り、結果に示す。同じ失敗を同じ調査で繰り返さない"
    tags { "spec"; "strength:MUST"; "area:gateway" }
    severity = "critical"
    reviewStatus = "approved"
    contributes { "GOAL-FAST" }
  }
  new {
    id = "P-03"
    name = "読み取りだけの操作で、承認待ちのために止まらない"
