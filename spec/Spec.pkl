  new {
    id = "Q-08"
    name = "論文・研究の知見を問う調査は一次資料（書誌・抄録、読めれば本文）に届く。届かない一次資料は理由つきで分かる"
    tags { "spec"; "strength:MUST"; "area:scholarly" }
    severity = "critical"
    reviewStatus = "approved"
    contributes { "GOAL-PRIMARY" }
  }
  new {
    id = "U-01"
    name = "決まった依頼形式・習慣・整理・機械ごとの設定を求めない。機械を足す作業はアカウント登録1回"
