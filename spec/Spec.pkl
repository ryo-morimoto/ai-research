// 制約の台帳（正）。ここが唯一の宣言（ADR-0001、利用者の決定 2026-10-30）。
// 検査は scripts/check-constraints.mjs が pkspec で行う。ビューは docs/generated/ に生成される。
// tags の読み方：strength:*（MUST / MUST-NOT / SHOULD）、area:*（持ち場）、
// ops＝リポジトリの CI では判定できず運用（点検・実機・計測）で確かめるもの
amends "./pkl/Spec.pkl"

feature = "ai-research constraints"

goals {
  new Goal { id = "GOAL-FAST"; name = "調査にかかる時間を短くする（無駄・遅さ・停滞を減らす）"; priority = 90; reviewStatus = "approved" }
  new Goal { id = "GOAL-SAME-EVERYWHERE"; name = "どの機械・どの会話から依頼しても、同じ依頼には同じ結果が同じ速さで返る"; priority = 90; reviewStatus = "approved" }
  new Goal { id = "GOAL-VERIFIED"; name = "答えの根拠は、原文と照合された引用である（確かさを人が追える）"; priority = 85; reviewStatus = "approved" }
  new Goal { id = "GOAL-PRIMARY"; name = "論文・研究の知見を問う調査は一次資料に届く"; priority = 80; reviewStatus = "approved" }
  new Goal { id = "GOAL-ON-PATH"; name = "調べものは、指定がなくてもこのシステムの経路を通る"; priority = 80; reviewStatus = "approved" }
  new Goal { id = "GOAL-NO-BURDEN"; name = "利用者に習慣・設定・保守を求めない"; priority = 70; reviewStatus = "approved" }
  new Goal { id = "GOAL-RESPECT"; name = "出典・外部サービス・第三者に配慮する（規約・頻度・著作権・送信の最小化）"; priority = 70; reviewStatus = "approved" }
  new Goal { id = "GOAL-BOUNDED-COST"; name = "費用と資源に上限があり、超える前に止まる"; priority = 60; reviewStatus = "approved" }
  new Goal { id = "GOAL-OBSERVABLE"; name = "調査の記録を、トークンをほぼ使わずに本人が見られる"; priority = 50; reviewStatus = "approved" }
}

scenarios {
  new {
    id = "W-01"
    name = "依頼から60秒以内に、向きを確かめられる最初の結果を出す"
    tags { "spec"; "strength:MUST"; "area:run" }
    severity = "critical"
    reviewStatus = "approved"
    contributes { "GOAL-FAST" }
  }
  new {
    id = "W-02"
    name = "利用者が向きを変えたら以降の作業に反映し、外れた作業を続けない"
    tags { "spec"; "strength:MUST"; "area:run" }
    severity = "critical"
    reviewStatus = "approved"
    contributes { "GOAL-FAST" }
  }
  new {
    id = "W-03"
    name = "以前に確かめた事実は、出典が変わっていなければ読み直しに時間を使わない（機械・会話をまたいで）"
    tags { "spec"; "strength:MUST"; "area:ledger" }
    severity = "critical"
    reviewStatus = "approved"
    contributes { "GOAL-FAST"; "GOAL-SAME-EVERYWHERE" }
  }
  new {
    id = "W-04"
    name = "4分を超える調査は、利用者が求めたとき（deepen）だけ行う"
    tags { "spec"; "strength:MUST"; "area:run" }
    severity = "critical"
    reviewStatus = "approved"
    contributes { "GOAL-FAST"; "GOAL-BOUNDED-COST" }
  }
  new {
    id = "S-01"
    name = "調査が長くなっても、1ステップあたりの時間と流入量が増え続けない"
    tags { "spec"; "strength:MUST"; "area:run/budget" }
    severity = "critical"
    reviewStatus = "approved"
    contributes { "GOAL-FAST" }
  }
  new {
    id = "S-02"
    name = "休憩やセッションの区切りを挟んでも、再開が大きく遅くならない"
    tags { "spec"; "strength:MUST"; "area:run" }
    severity = "critical"
    reviewStatus = "approved"
    contributes { "GOAL-FAST" }
  }
  new {
    id = "S-03"
    name = "原文の取得は、選べる経路のうち最も速いものに近い（要約を挟まない）"
    tags { "spec"; "strength:MUST"; "area:gateway" }
    severity = "critical"
    reviewStatus = "approved"
    contributes { "GOAL-FAST" }
  }
  new {
    id = "S-04"
    name = "依頼の難しさに対して思考量を過大にしない"
    tags { "spec"; "strength:SHOULD"; "area:conversation" }
    severity = "minor"
    reviewStatus = "approved"
    contributes { "GOAL-FAST" }
  }
  new {
    id = "S-05"
    name = "会話で回るターン数と流し込む量が、会話の長さや作業場所によって増えない"
    tags { "spec"; "strength:MUST"; "area:mcp/budget" }
    severity = "critical"
    reviewStatus = "approved"
    contributes { "GOAL-FAST"; "GOAL-SAME-EVERYWHERE" }
