{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ai-research",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // global_fetch_strictly_public：外への fetch を公開のインターネットだけに限る。
  // OAuth の Client ID Metadata Document（claude.ai の「Claude's published identity」）の取得に必要で、
  // 取得の出口の SSRF 対策にもなる
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "durable_objects": {
    "bindings": [
      { "name": "LEDGER", "class_name": "LedgerDO" },
      { "name": "RUNS", "class_name": "RunDO" },
      { "name": "LIMITER", "class_name": "HostLimiterDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LedgerDO", "RunDO", "HostLimiterDO"] }],
  "worker_loaders": [{ "binding": "LOADER" }],
  // OAuth の状態。KV 名前空間を cf で作り、id を差し替える（docs/04 §2.2）
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "REPLACE_WITH_OAUTH_KV_ID" }],
  "vars": {
    "SEARCH_PROVIDER": "none"
  },
  "observability": { "enabled": true }
}
