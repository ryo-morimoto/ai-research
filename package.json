{
  "name": "ai-research",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint:deps": "node scripts/check-deps.mjs",
    "spec:check": "node scripts/check-specs.mjs",
    "lint:constraints": "node --experimental-strip-types --no-warnings scripts/check-constraints.mjs --check",
    "constraints:write": "node --experimental-strip-types --no-warnings scripts/check-constraints.mjs --write",
    "check": "pnpm lint:deps && pnpm lint:budget && pnpm lint:constraints && pnpm spec:check && pnpm typecheck && pnpm test",
    "lint:budget": "node --experimental-strip-types --no-warnings scripts/check-budget.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
